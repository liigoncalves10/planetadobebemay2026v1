  // general [desktop] - menu: contact
  "vtex.menu@2.x:menu#general-menu-contact": {
    "props": {
      "blockClass": "generalMenu",
      "orientation": "vertical"
    },
    "children": [
      "rich-text#title-menu-atendimento",
      "menu-item#contact-telephone",
      "menu-item#contact-schedule",
      "menu-item#contact-email",
      "link#fale-conosco",
      "flex-layout.row#social-container"
    ]
  },

  "rich-text#title-menu-atendimento":{
    "title":"Título menu Atendimento",
    "props":{
      "text": "#### Atendimento",
      "blockClass": "generalMenuTitle"

    }

  },
  "menu-item#contact-telephone": {
    "props": {
      "blockClass": "generalMenuItem",
      "itemProps": {
        "tagTitle": "+55 11 3895.1572",
        "text": "+55 11 3895.1572"
      }
    }
  },
  "menu-item#contact-schedule": {
    "props": {
      "blockClass": ["generalMenuItem", "noLink"],
      "itemProps": {
        "href": "#",
        "tagTitle": "Seg a Sex das 08 às 18h",
        "text": "Seg a Sex das 08 às 18h"
      }
    }
  },
  "menu-item#contact-email": {
    "props": {
      "blockClass": "generalMenuItem",
      "itemProps": {
        "href": "mailto:sac@planetadobebe.com.br",
        "tagTitle": "sac@planetadobebe.com.br",
        "text": "sac@planetadobebe.com.br"
      }
    }
  },
  "link#fale-conosco": {
    "props": {
      "blockClass": ["generalMenuItem", "contactUs"],
      "href": "/institutional/fale-conosco"
    },
    "children": ["rich-text#fale-conosco-footer"]
  },
  "rich-text#fale-conosco-footer": {
    "title": "Fale Conosco",
    "props": {
      "tagTitle": "Fale Conosco",
      "text": "##### Fale Conosco",
      "blockClass": "generalMenuLink"
    }
  },
  // icones sociais footer - desktop
  "flex-layout.row#social-container": {
      "children": [
        "rich-text#social-links-facebook",
        "rich-text#social-links-instagram",
        "rich-text#social-links-youtube"
      ],
      "props": {
        "blockClass": "social-icons-flexContainer"
      }
  },

  "rich-text#social-links-facebook": {
    "props": {
      "text": "<a class='vtex-rich-text-0-x-link--social-networks' href='https://www.facebook.com/planeta.dobebe.79' target='_blank'><img class='vtex-rich-text-0-x-image--social-networks' src='/arquivos/facebook-icon-pl.png'></a>",
      "blockClass": "social-networks--footer"
    }
  },

  "rich-text#social-links-instagram": {
    "props": {
      "text": "<a class='vtex-rich-text-0-x-link--social-networks' href='https://www.instagram.com/lojaplanetadobebe/' target='_blank'><img class='vtex-rich-text-0-x-image--social-networks' src='/arquivos/instagram-icon-pl.png'></a>",
      "blockClass": "social-networks--footer"
    }
  },

  "rich-text#social-links-youtube": {
    "props": {
      "text": "<a class='vtex-rich-text-0-x-link--social-networks' href='https://www.youtube.com/channel/UC1h3dZa-kIr4KYoPp0Y_Ekw' target='_blank'><img class='vtex-rich-text-0-x-image--social-networks' src='/arquivos/youtube-icon-pl.png'></a>",
      "blockClass": "social-networks--footer"
    }
  },

  // general [mobile] - menu: institutional
  "menu-item#general-menu-institutional-mobile": {
    "blocks": [
      "vtex.menu@2.x:submenu.accordion#general-accordion-institutional"
    ],
    "props": {
      "blockClass": "generalMenuTitleMobile",
      "itemProps": {
        "href": "#",
        "tagTitle": "Institucional",
        "text": "Institucional"
      }
    }
  },
  "vtex.menu@2.x:submenu.accordion#general-accordion-institutional": {
    "children": ["vtex.menu@2.x:menu#general-menu-institutional-mobile"],
    "props": {
      "blockClass": ["accordion", "generalAccordion"]
    }
  },
  "vtex.menu@2.x:menu#general-menu-institutional-mobile": {
    "props": {
      "blockClass": ["generalMenu", "generalMenuMobile"],
      "orientation": "vertical"
    },
    "children": [
      "link#sobre-a-gente",
      "link#politica-de-compra-segura",
      "link#politica-de-privacidade",
      "link#politica-de-trocas-fisica",
      "link#politica-de-trocas",
      "link#termos-e-condicoes-gerais"
    ]
  },

  // general [mobile] - menu: help
  "menu-item#general-menu-help-mobile": {
    "blocks": ["vtex.menu@2.x:submenu.accordion#general-accordion-help"],
