      "flex-layout.row#club-extras"
    ]
  },
  "rich-text#club-banner-mobile": {
    "props": {
      "title": "banner-mobile-club",
      "text": "<a class='vtex-rich-text-0-x-link--banner-club' href='/club' target='_blank'><img class='vtex-rich-text-0-x-image--banner-club--mobile' src='/arquivos/club-banner-mobile.png'></a>",
      "blockClass": ["club-images", "club-images--mobile"],
      "minHeight": "500px"
    }
  },
  "rich-text#club-banner-desktop": {
    "props": {
      "title": "banner-desktop-club",
      "text": "<a class='vtex-rich-text-0-x-link--banner-club' href='/club' target='_blank'><img class='vtex-rich-text-0-x-image--banner-club--desktop' src='/arquivos/club-banner-desk.png'></a>",
      "blockClass": ["club-images", "club-images--desktop"],
      "minHeight": "400px"
    }
  },
  "flex-layout.row#club-breadcrumb": {
    "children": ["breadcrumb.search"],
    "props": {
      "blockClass": ["breadcrumb-row", "row-search"],
      "preserveLayoutOnMobile": true,
      "fullWidth": true
    }
  },

  "flex-layout.row#club-about": {
    "props": {
      "blockClass": "club-about"
    },
    "children": [
      "rich-text#club-title",
      "rich-text#club-content"
    ]
  },
