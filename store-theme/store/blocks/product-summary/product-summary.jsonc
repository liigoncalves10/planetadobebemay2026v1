{
  "product-summary.shelf": {
    "children": [
      "stack-layout#prodsum",
      "product-summary-name",
      "flex-layout.col#productRating",
      "product-summary-space",
      "product-installments#summary",
      "product-list-price#summary",
      "flex-layout.row#selling-price-savings",
      "add-to-cart-button"
    ]
  },
  "flex-layout.col#productRating": {
    "props": {
      "blockClass": "productRating"
    },
    "children": ["product-rating-inline"]
  },

  "stack-layout#prodsum": {
    "children": [
      "product-summary-image#shelf",
      "vtex.product-highlights@2.x:product-highlights#collection",
      "modal-trigger#quickview" // Check quickview.jsonc
    ]
  },

  "product-summary-image#shelf": {
    "props": {
      "showBadge": true,
      "aspectRatio": "1:1",
      "maxHeight": 300
    }
  },

  "vtex.product-highlights@2.x:product-highlights#collection": {
    "props": {
      "type": "collection"
    },
    "children": ["product-highlight-wrapper"]
  },
  "product-highlight-wrapper": {
    "props": {
      "blockClass": "collection"
    },
    "children": ["product-highlight-text"]
  },
  "product-highlight-text": {
    "props": {
      "message": "{highlightName}"
    }
  },

  "product-list-price#summary": {
    "props": {
      "blockClass": "summary"
    }
  },
  "flex-layout.row#selling-price-savings": {
    "props": {
      "colGap": 2,
      "preserveLayoutOnMobile": true,
      "preventHorizontalStretch": true,
      "marginBottom": 4
    },
    "children": [
      "product-selling-price#summary",
      "PixDiscountShelf",
      "product-price-savings#summary"
    ]
  },
  "product-installments#summary": {
    "props": {
      "blockClass": "summary"
    }
  },
  "product-selling-price#summary": {
    "props": {
      "blockClass": "summary"
    }
  },
  "PixDiscountShelf": {
    "props": {
      "porcentagem": "5",
      "exibir": true
    }
  },
  "product-price-savings#summary": {
    "props": {
      "markers": ["discount"],
      "blockClass": "summary"
    }
  },
  // Adicione isso ao product-summary.jsonc para corrigir a Busca

  "flex-layout.row#price-row-shelf": {
    "props": {
      "blockClass": "price-row-shelf"
    },
    "children": [
      "flex-layout.row#pix-price",
      "flex-layout.row#cash-or-card",
      "product-installments"
    ]
  },

  "flex-layout.row#pix-price": {
    "children": ["PixDiscountShelf"], // Certifique-se que esse componente existe ou use "product-price-savings"
    "props": {
      "blockClass": "row-pix-price"
    }
  },

  "flex-layout.row#cash-or-card": {
    "props": {
      "blockClass": "row-cash-or-card"
    },
    "children": ["product-summary-price"]
  },

  // Definição padrão do preço (caso não exista no arquivo)
  "product-summary-price": {
    "props": {
      "showListPrice": false,
      "showInstallments": false,
      "showLabels": false
    }
  },
  // Adicione isso ao final do product-summary.jsonc

  "add-to-cart-button#main-shelf-buy-button": {
    "props": {
      "blockClass": ["main-shelf-buy-button"],
      "text": "Comprar",
      "addToCartFeedback": "customEvent",
      "customPixelEventId": "add-to-cart-button",
      "marginTop": 10
    }
  }
}
