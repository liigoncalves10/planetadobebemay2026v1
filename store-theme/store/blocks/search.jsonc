{
  "store.search": {
    "blocks": ["search-result-layout#search-page"],
    "props": {
      "context": {
        "skusFilter": "ALL",
        "maxItemsPerPage": 18,
        "simulationBehavior": "default"
      }
    }
  },

  "search-result-layout": {
    "blocks": [
      "search-result-layout.desktop",
      "search-result-layout.mobile",
      "search-not-found-layout"
    ]
  },

  "search-result-layout#search-page": {
    "blocks": [
      "search-result-layout.desktop#search-page",
      "search-result-layout.mobile#search",
      "search-not-found-layout"
    ]
  },

  "search-result-layout.desktop#search-page": {
    "children": [
      "flex-layout.row#admin-banner-department",
      "flex-layout.row#searchbread",
      "flex-layout.row#searchtitle",
      "flex-layout.row#result"
    ],
    "props": {
      "pagination": "show-more",
      "preventRouteChange": false,
      "blockClass": "search-page-container",
      "defaultGalleryLayout": "grid"
    }
  },
  "search-result-layout.desktop": {
    "children": [
      "flex-layout.row#admin-banner-department",
      "flex-layout.row#searchbread",
      "flex-layout.row#searchtitle",
      "flex-layout.row#result"
      //"rich-text#seo-title",
      //"rich-text#seo-content",
      //"flex-layout.row#seo-cards-row-1",
      //"flex-layout.row#seo-cards-row-2",
      //"flex-layout.row#seo-cards-row-3",
      //"flex-layout.row#seo-cards-row-4"
    ],
    "props": {
      "pagination": "show-more",
      "preventRouteChange": false,
      "blockClass": "container-category",
      "defaultGalleryLayout": "grid"
    }
  },

  "flex-layout.row#searchbread": {
    "children": ["breadcrumb.search"],
    "props": {
      "blockClass": ["breadcrumb-row", "row-search"],
      "preserveLayoutOnMobile": true,
      "fullWidth": true
    }
  },
  "breadcrumb.search": {
    "props": {
      "showOnMobile": true
    }
  },
  "flex-layout.row#searchtitle": {
    "children": ["search-title.v2"],
    "props": {
      "blockClass": ["title-row", "row-search"]
    }
  },
  "flex-layout.row#result": {
    "children": ["flex-layout.col#filter", "flex-layout.col#content"],
    "props": {
      "preventHorizontalStretch": true,
      "fullWidth": true,
      "blockClass": ["result-row", "row-search"]
    }
  },
  "flex-layout.col#filter": {
    "children": ["filter-navigator.v3"],
    "props": {
      "blockClass": "filterCol"
    }
  },
  "filter-navigator.v3": {
    "props": {
      "blockClass": ["filter-mobile"],
      "categoryFiltersMode": "href",
      "filtersTitleHtmlTag": "p",
      "facetOrdering": [
        {
          "key": "brand",
          "orderBy": "name",
          "order": "ASC"
        }
      ]
    },
    "blocks": ["sidebar-close-button"]
  },
  "sidebar-close-button": {
    "props": {
      "blockClass": "close-filter",
      "size": 20
    }
  },
  "flex-layout.col#content": {
    "children": [
      "flex-layout.row#searchinfo",
      // "flex-layout.row#fetchprevious",
      "flex-layout.row#products",
      "flex-layout.row#fetchmore"
    ],
    "props": {
      "width": "grow",
      "preventVerticalStretch": true
    }
  },
  "flex-layout.row#searchinfo": {
    "children": [
      "flex-layout.col#productCount",
      "flex-layout.row#orderByAndSwitcher"
    ]
  },
  "flex-layout.row#orderByAndSwitcher": {
    "children": [
      "order-by.v2"
      // "gallery-layout-switcher"
    ],
    "props": {
      "horizontalAlign": "right",
      "preventHorizontalStretch": true,
      "blockClass": "orderByAndSwitcher",
      "colGap": 3
    }
  },
  "flex-layout.col#productCount": {
    "children": ["total-products.v2"],
    "props": {
      "blockClass": "productCountCol"
    }
  },
  "flex-layout.row#fetchprevious": {
    "props": {
      "marginBottom": 3,
      "blockClass": "fetchprevious"
    },
    "children": ["search-fetch-previous"]
  },
  "flex-layout.row#fetchmore": {
    "props": {
      "marginTop": 3
    },
    "children": ["search-fetch-more"]
  },
  "flex-layout.row#products": {
    "children": ["search-content"]
  },
  "search-content": {
    "blocks": ["gallery", "not-found"]
  },

  "search-result-layout.mobile#search": {
    "children": [
      "flex-layout.row#admin-banner-department",
      // "flex-layout.row#searchbread",
      "flex-layout.row#searchtitle",
      "flex-layout.row#searchinfomobile",
      "flex-layout.row#productCountMobile",
      "flex-layout.row#contentmobile",
      "flex-layout.row#fetchmore"
    ],
    "props": {
      "pagination": "show-more",
      "blockClass": "search-page-container",
      "mobileLayout": {
        "mode1": "small",
        "mode2": "normal"
      },
      "defaultGalleryLayout": "grid"
    }
  },

  "search-result-layout.mobile": {
    "children": [
      "flex-layout.row#admin-banner-department",
      "flex-layout.row#searchbread",
      "flex-layout.row#searchtitle",
      "flex-layout.row#searchinfomobile",
      "flex-layout.row#productCountMobile",
      // "flex-layout.row#fetchprevious",
      "flex-layout.row#contentmobile",
      "flex-layout.row#fetchmore"
      //"rich-text#seo-title",
      //"rich-text#seo-content",
      //"flex-layout.row#seo-cards-row-1",
      //"flex-layout.row#seo-cards-row-2",
      //"flex-layout.row#seo-cards-row-3",
      //"flex-layout.row#seo-cards-row-4"
    ],
    "props": {
      "pagination": "show-more",
      "mobileLayout": {
        "mode1": "small",
        "mode2": "normal"
      },
      "defaultGalleryLayout": "grid"
    }
  },
  "flex-layout.row#contentmobile": {
    "children": ["search-content"],
    "props": {
      "blockClass": "",
      "preserveLayoutOnMobile": true
    }
  },

  "flex-layout.row#searchinfomobile": {
    "children": [
      "flex-layout.col#orderByMobile",
      "flex-layout.col#filterMobile"
      // "flex-layout.col#switcherMobile"
    ],
    "props": {
      "preserveLayoutOnMobile": true,
      "colSizing": "auto",
      "colJustify": "center",
      "horizontalAlign": "center",
      "blockClass": "search-info"
    }
  },

  "flex-layout.col#orderByMobile": {
    "children": ["order-by.v2"],
    "props": {
      "blockClass": "orderByMobileCol"
    }
  },

  "flex-layout.row#productCountMobile": {
    "children": ["total-products.v2"],
    "props": {
      "blockClass": "productCountMobileRow"
    }
  },

  "flex-layout.col#filterMobile": {
    "children": ["filter-navigator.v3"],
    "props": {
      "blockClass": "filterMobileCol"
    }
  },
  "flex-layout.col#switcherMobile": {
    "children": ["gallery-layout-switcher"],
    "props": {
      "verticalAlign": "middle"
    }
  },
  "search-not-found-layout": {
    "props": { "blockClass": "layout-container-nofound" },
    "children": [
      "flex-layout.row#searchbread",
      "flex-layout.row#notfound",
      "rich-text#shelf-title-notfound",
      "flex-layout.row#shelf-notfound"
    ]
  },
  "rich-text#shelf-title-notfound": {
    "title": "título-prateleira",
    "props": {
      "text": "Ofertas",
      "blockClass": "shelf-title"
    }
  },
  "flex-layout.row#shelf-notfound": {
    "props": {
      "blockClass": ["main-shelf-row"]
    },
    "title": "container-prateleira",
    "children": ["list-context.product-list#-notfound"]
  },
  "list-context.product-list#-notfound": {
    "title": "prateleira",
    "blocks": ["product-summary.shelf#main-shelf"],
    "children": ["slider-layout#main-shelf-products"],
    "props": {
      "blockClass": ["main-shelf-context"],
      "orderBy": ""
    }
  },
  "slider-layout#demo-products-notfound": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 2
      },
      "infinite": true,
      "fullWidth": false,
      "blockClass": ["product-summary-shelf", "shelf-notfound"]
    }
  },
  "flex-layout.row#notfound": {
    "children": ["not-found"],
    "props": {
      "fullWidth": true
    }
  },

  "breadcrumb": {
    "props": {
      "showOnMobile": true
    }
  },

  "gallery": {
    "props": {
      "layouts": [
        {
          "name": "grid",
          "component": "GridSummary",
          "itemsPerRow": {
            "(min-width:1300px)": 3,
            "desktop": 3,
            "tablet": 3,
            "phone": 2
          }
        },
        {
          "name": "list",
          "component": "ListSummary",
          "itemsPerRow": 1
        }
      ],
      "ListSummary": "product-summary.shelf#listLayout",
      "GridSummary": "product-summary.shelf#main-shelf"
    }
  },
  "gallery-layout-switcher": {
    "children": [
      /*
       * For accessbility to work properly,
       * It's important to define the options in the same order as the layouts
       */
      "gallery-layout-option#grid",
      "gallery-layout-option#list"
    ]
  },
  "gallery-layout-option#grid": {
    "props": {
      "name": "grid"
    },
    "children": ["icon-grid", "responsive-layout.desktop#textOptionGrid"]
  },
  "gallery-layout-option#list": {
    "props": {
      "name": "list"
    },
    "children": ["icon-inline-grid", "responsive-layout.desktop#textOptionList"]
  },
  "responsive-layout.desktop#textOptionGrid": {
    "children": ["rich-text#option-grid"]
  },
  "responsive-layout.desktop#textOptionList": {
    "children": ["rich-text#option-list"]
  },
  "rich-text#option-grid": {
    "props": {
      "text": "Grid",
      "textColor": "c-auto",
      "blockClass": "layout-option"
    }
  },
  "rich-text#option-list": {
    "props": {
      "text": "List",
      "textColor": "c-auto",
      "blockClass": "layout-option"
    }
  },
  "flex-layout.row#admin-banner-department": {
    "children": ["search-banner#banner-department"],
    "props": {
      "blockClass": "banner-department"
    }
  },

  "search-banner#banner-department": {
    "props": {
      "area": "one",
      "blockClass": "banner-department",
      "horizontalAlignment": "center"
    }
  }
}
