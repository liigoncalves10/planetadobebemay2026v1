    ]
  },

  /* Placeholders para outros modais */
  "modal-layout#lp-modal-article-4": { "props": { "blockClass": "lp-modal-article-container" }, "children": ["modal-header#lp-modal", "rich-text#modal-placeholder"] },
  "modal-layout#lp-modal-article-5": { "props": { "blockClass": "lp-modal-article-container" }, "children": ["modal-header#lp-modal", "rich-text#modal-placeholder"] },
