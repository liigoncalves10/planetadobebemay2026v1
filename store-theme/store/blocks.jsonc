  "modal-layout#lp-modal-article-9": { "props": { "blockClass": "lp-modal-article-container" }, "children": ["modal-header#lp-modal", "rich-text#modal-placeholder"] },

  "modal-header#lp-modal": {
    "props": { "blockClass": "lp-modal-article-container" }
  },
  "rich-text#modal-placeholder": {
    "props": { "text": "Conteúdo do artigo em breve...", "textAlignment": "CENTER", "textPosition": "CENTER" }
  }
}
