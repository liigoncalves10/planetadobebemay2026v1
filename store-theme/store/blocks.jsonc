{
  "store.orderplaced": {
    "blocks": ["order-placed"]
  },

  "store.account": {
    "blocks": ["my-account"],
    "parent": {
      "challenge": "challenge.profile"
    }
  },

  "store.login": {
    "blocks": ["login-content#default"]
  },

  "login-content#default": {
    "props": {
      "isInitialScreenOptionOnly": false,
      "defaultOption": 1,
      "showPasswordVerificationIntoTooltip": true
    }
  },

  "store.product-review-form": {
    "blocks": ["product-review-form"]
  },

  "store.not-found#product": {
    "blocks": ["rich-text#not-found"]
  },

  "store.not-found#search": {
    "blocks": ["rich-text#not-found"]
  },

  "rich-text#not-found": {
    "props": {
      "textAlignment": "CENTER",
      "textPosition": "CENTER",
      "text": "**404 <br/> Página Não Encontrada!**",
      "font": "t-heading-1",
      "blockClass": "textNotFound"
    }
  },

  /*
     BLOCO GLOBAL REUTILIZÁVEL - NA MÍDIA
     Declarado aqui para permitir reutilização entre Home e Landing Page.
  */
  "flex-layout.row#naMidia__grid-cards-slider": {
    "title": "Na Mídia - Seção Global",
    "children": ["flex-layout.col#naMidia__grid-cards-slider-col"],
    "props": {
      "blockClass": "naMidia__section-row",
      "marginTop": 6,
      "marginBottom": 8
    }
  },

  "flex-layout.col#naMidia__grid-cards-slider-col": {
    "title": "Na Mídia - Coluna Home",
    "children": [
      "rich-text#lp-grid-title",
      "slider-layout#home__naMidia__grid-cards-slider"
    ]
  },

  "rich-text#lp-grid-title": {
    "title": "Na Mídia - Título",
    "props": {
      "text": "## Na Mídia",
      "textAlignment": "LEFT",
      "textPosition": "LEFT",
      "blockClass": "shelf-title"
    }
  },

  /* BLOCO ESPECIALIZADO PARA HOME */
  "slider-layout#home__naMidia__grid-cards-slider": {
    "title": "Na Mídia - Slider Home",
    "props": {
      "itemsPerPage": {
        "desktop": 3,
        "tablet": 2,
        "phone": 1
      },
      "infinite": true,
      "showNavigationArrows": "always",
      "showPaginationDots": "always",
      "blockClass": "naMidia__grid-cards-slider",
      "fullWidth": false,
      "experimentalHideEmptyItems": true
    },
    "children": [
      "flex-layout.col#lp-card-1",
      "flex-layout.col#lp-card-2",
      "flex-layout.col#lp-card-3",
      "flex-layout.col#lp-card-4"
    ]
  },

  /* BLOCO ESPECIALIZADO PARA LANDING PAGE */
  "flex-layout.row#lp__naMidia__grid-cards-slider": {
    "title": "Na Mídia - Seção LP",
    "children": ["flex-layout.col#lp__naMidia__grid-cards-slider-col"],
    "props": {
      "blockClass": "naMidia__section-row",
      "marginTop": 6,
      "marginBottom": 8
    }
  },

  "flex-layout.col#lp__naMidia__grid-cards-slider-col": {
    "title": "Na Mídia - Coluna LP",
    "children": ["rich-text#lp-grid-title", "slider-layout#lp__naMidia__grid-cards-slider"]
  },

  "slider-layout#lp__naMidia__grid-cards-slider": {
    "title": "Na Mídia - Slider LP",
    "props": {
      "itemsPerPage": {
        "desktop": 3,
        "tablet": 2,
        "phone": 1
      },
      "infinite": true,
      "showNavigationArrows": "always",
      "showPaginationDots": "always",
      "blockClass": "naMidia__grid-cards-slider",
      "fullWidth": false,
      "experimentalHideEmptyItems": true
    },
    "children": [
      "flex-layout.col#lp-card-1",
      "flex-layout.col#lp-card-2",
      "flex-layout.col#lp-card-3"
    ]
  },

  /* Card Definitions */
  "flex-layout.col#lp-card-1": {
    "title": "Na Mídia - Card 1",
    "children": ["flex-layout.col#lp-card-1-content", "link#lp-card-1-button"],
    "props": { "blockClass": "naMidia__card-col", "horizontalAlign": "center" }
  },
  "flex-layout.col#lp-card-1-content": {
    "children": ["modal-trigger#lp-card-1"],
    "props": { "blockClass": "naMidia__card-content", "horizontalAlign": "center" }
  },
  "modal-trigger#lp-card-1": {
    "children": ["image#lp-card-1-img", "modal-layout#lp-modal-article-1"],
    "props": { "blockClass": "naMidia__card-trigger" }
  },
  "image#lp-card-1-img": {
    "props": { "src": "https://via.placeholder.com/400x300", "blockClass": "naMidia__card-img" }
  },
  "link#lp-card-1-button": {
    "props": {
      "href": "/artigo-1",
      "label": "Ver mais",
      "blockClass": "naMidia__card-button"
    }
  },

  "flex-layout.col#lp-card-2": {
