  /* Modais de Artigos - Definições Globais */
  "modal-layout#lp-modal-article-1": {
    "props": { "blockClass": "lp-modal-article-container" },
    "children": ["modal-header#lp-modal", "modal-content#lp-modal-1"]
  },
  "modal-content#lp-modal-1": {
    "children": [
      "rich-text#artigo-carrinho-title",
      "image#artigo-carrinho-img",
      "rich-text#artigo-carrinho-body"
    ]
  },

  "modal-layout#lp-modal-article-2": {
    "props": { "blockClass": "lp-modal-article-container" },
